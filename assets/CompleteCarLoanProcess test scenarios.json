{
  "$schema": "https://camunda.com/json-schema/cpt-test-cases/8.10/schema.json",
  "processId": "RoutingDecision-1",
  "testCases": [
    {
      "name": "background-check-and-granted",
      "description": "Exercise 4 example: background check, then the loan is granted",
      "instructions": [
        {
          "type": "CREATE_PROCESS_INSTANCE",
          "processDefinitionSelector": {
            "processDefinitionId": "RoutingDecision-1"
          },
          "variables": {
            "creditScore": 82,
            "borrowersIncome": 1200,
            "expenses": 800,
            "installmentRate": 100,
            "knownCustomer": true,
            "loanAmount": 1000,
            "employment": "self-employed"
          }
        },
        {
          "type": "ASSERT_PROCESS_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "RoutingDecision-1"
          },
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_VARIABLES",
          "processInstanceSelector": {
            "processDefinitionId": "RoutingDecision-1"
          },
          "variables": {
            "backgroundCheck": true,
            "carLoanGranted": "Granted"
          }
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "RoutingDecision-1"
          },
          "elementSelector": {
            "elementId": "Activity_07h9fyz"
          },
          "state": "IS_COMPLETED"
        }
      ]
    },
    {
      "name": "no-check-and-rejected",
      "description": "Known employed customer, unaffordable loan: rejected",
      "instructions": [
        {
          "type": "CREATE_PROCESS_INSTANCE",
          "processDefinitionSelector": {
            "processDefinitionId": "RoutingDecision-1"
          },
          "variables": {
            "creditScore": 82,
            "borrowersIncome": 1200,
            "expenses": 800,
            "installmentRate": 300,
            "knownCustomer": true,
            "loanAmount": 5000,
            "employment": "employed"
          }
        },
        {
          "type": "ASSERT_PROCESS_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "RoutingDecision-1"
          },
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_VARIABLES",
          "processInstanceSelector": {
            "processDefinitionId": "RoutingDecision-1"
          },
          "variables": {
            "backgroundCheck": false,
            "carLoanGranted": "Rejected"
          }
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "RoutingDecision-1"
          },
          "elementSelector": {
            "elementId": "Activity_0il1jar"
          },
          "state": "IS_COMPLETED"
        }
      ]
    }
  ]
}
