{
  "$schema": "https://camunda.com/json-schema/cpt-test-cases/8.10/schema.json",
  "processId": "Exercise1-2-3Process",
  "testCases": [
    {
      "name": "installment-100-affordable-granted",
      "description": "Ratio 25 (affordable), risk medium: granted",
      "instructions": [
        {
          "type": "CREATE_PROCESS_INSTANCE",
          "processDefinitionSelector": {
            "processDefinitionId": "Exercise1-2-3Process"
          },
          "variables": {
            "creditScore": 82,
            "borrowersIncome": 1200,
            "expenses": 800,
            "installmentRate": 100
          }
        },
        {
          "type": "ASSERT_PROCESS_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "Exercise1-2-3Process"
          },
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_VARIABLES",
          "processInstanceSelector": {
            "processDefinitionId": "Exercise1-2-3Process"
          },
          "variables": {
            "result": "Granted"
          }
        }
      ]
    },
